{
	"name": "openbotlounge",
	"private": true,
	"version": "0.1.0",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "bash scripts/deploy.sh",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"prepare": "svelte-kit sync",
		"start": "node build",
		"test": "vitest run",
		"test:shuffle": "vitest run --sequence.shuffle"
	},
	"dependencies": {
		"@humanspeak/svelte-markdown": "^1.9.0",
		"ghostty-web": "^0.4.0"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^0.85.1",
		"@earendil-works/pi-coding-agent": "^0.85.1",
		"highlight.js": "^11.11.1",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@types/node": "^24.0.0",
		"pi-memory": "^0.4.2",
		"svelte": "^5.19.0",
		"svelte-check": "^4.1.4",
		"typescript": "^5.7.3",
		"vite": "^6.0.11",
		"vitest": "^5.0.0"
	},
	"allowScripts": {
		"esbuild@0.25.12": true
	}
}
