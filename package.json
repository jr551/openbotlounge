{
	"name": "openbotlounge",
	"private": true,
	"version": "0.3.0",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "bash scripts/deploy.sh",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"prepare": "svelte-kit sync",
		"start": "node build",
		"test": "vitest run",
		"test:shuffle": "vitest run --sequence.shuffle"
	},
	"dependencies": {
		"@humanspeak/svelte-markdown": "^2.3.0",
		"ghostty-web": "^0.4.0"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@sveltejs/adapter-node": "^5.5.8",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@types/node": "^26.6.10",
		"cookie": "^0.7.2",
		"deepmerge": "^4.3.1",
		"highlight.js": "^11.12.0",
		"pi-memory": "^0.4.2",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"typescript": "^5.9.3",
		"undici": "^8.13.1",
		"vite": "^8.3.8",
		"vitest": "^5.1.2"
	},
	"overrides": {
		"@sveltejs/vite-plugin-svelte": "$@sveltejs/vite-plugin-svelte",
		"undici": "$undici",
		"cookie": "$cookie",
		"deepmerge": "$deepmerge"
	},
	"allowScripts": {
		"esbuild@0.25.12": true
	}
}
