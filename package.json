{
	"name": "openbotlounge",
	"private": true,
	"version": "0.2.0",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "bash scripts/deploy.sh",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"prepare": "svelte-kit sync",
		"start": "node build",
		"test": "vitest run",
		"test:shuffle": "vitest run --sequence.shuffle"
	},
	"dependencies": {
		"@humanspeak/svelte-markdown": "^2.1.3",
		"ghostty-web": "^0.4.0"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^1.4.0",
		"@earendil-works/pi-coding-agent": "^1.4.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.5",
		"highlight.js": "^11.11.1",
		"pi-memory": "^0.4.2",
		"svelte": "^5.19.0",
		"svelte-check": "^4.1.4",
		"typescript": "^5.7.3",
		"cookie": "^0.7.2",
		"deepmerge": "^4.3.1",
		"undici": "^8.12.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.0"
	},
	"overrides": {
		"@sveltejs/vite-plugin-svelte": "$@sveltejs/vite-plugin-svelte",
		"undici": "$undici",
		"cookie": "$cookie",
		"deepmerge": "$deepmerge"
	},
	"allowScripts": {
		"esbuild@0.25.12": true
	}
}
