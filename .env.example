# Any OpenAI-compatible chat-completions endpoint.
#   OpenRouter:  https://openrouter.ai/api/v1   (the default — signs in via OAuth)
#   xAI Grok:    https://api.x.ai/v1
#   Ollama:      http://host.docker.internal:11434/v1
#   LM Studio:   http://host.docker.internal:1234/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Blank uses the default driver model, deepseek/deepseek-v4.1-flash.
LLM_MODEL=

# Let the settings "Test connection" button probe a loopback/LAN address. Off by
# default because the probe runs in the server process, so an open one is an SSRF
# into the cloud metadata service or a LAN box. Turn it on for a self-hosted
# install whose provider is a local model server (Ollama, LM Studio); leave it
# off when the app is exposed beyond localhost.
PROVIDER_TEST_ALLOW_PRIVATE=false

# Exa (exa.ai) API key for the bots' search_web tool. Optional: without it the
# tool answers that search is not configured. Can also be set later through
# POST /api/settings as exa_api_key - a stored key wins over this one.
EXA_API_KEY=

# Key for encrypting stored bot secrets. Unset = generated once into
# DATA_DIR/secrets.key (mode 600) and reused. Setting it explicitly is optional
# but lets you move the database between hosts without re-entering secrets.
SECRETS_KEY=

# Optional shared-password gate (recommended if exposed beyond localhost).
APP_PASSWORD=
# Stable session-signing secret; random per boot if unset (sessions reset on restart).
SESSION_SECRET=

# Cap messages sent to the provider per request (0 = send all).
MAX_HISTORY_MESSAGES=0

# What one bot turn is allowed to spend before it hands the work back: model
# round-trips, an approximate token budget (characters streamed / 4) and a
# wall-clock ceiling. A turn that hits one of these still saves what it wrote.
LLM_MAX_TURNS=8
LLM_MAX_TOKENS_PER_TASK=200000
LLM_TASK_TIMEOUT_MS=300000
# Seconds to wait on a single provider call (a stalled socket otherwise hangs
# the caller, and with it every scheduled job).
LLM_TIMEOUT_MS=120000

# Per-bot agent sandboxes (ghcr.io/agent-infra/sandbox): browser, shell, files,
# VSCode, MCP + noVNC screen per bot. Idle sandboxes auto-sleep.
SANDBOX_IMAGE=ghcr.io/agent-infra/sandbox:latest
SANDBOX_API_KEY=
SANDBOX_IDLE_MINUTES=15
SANDBOX_NETWORK=openbotlounge_default
# Set to false to leave orphaned sandbox containers alone on boot.
SANDBOX_ORPHAN_SWEEP=true

# Your name, used to spot @mentions that should ping you.
USER_NAME=you

# Let bots chat among themselves on a schedule, and how often.
BOT_SOCIAL=true
BOT_SOCIAL_MINUTES=60

# How often the police bot reviews every bot's token spend and patrols what the
# fleet ingested and ran, in hours. Findings appear in Settings -> Police.
POLICE_INTERVAL_HOURS=12

# Where the SQLite file and the screenshot images live.
DATA_DIR=./data
# Docker socket path, if yours is not the default.
DOCKER_SOCKET=/var/run/docker.sock
# How long to wait for the Docker socket, in milliseconds.
DOCKER_TIMEOUT_MS=30000

# Ceiling on a single command inside a sandbox. The sandbox API only answers
# when the command ends, so without this a wedged command pins the turn forever.
SANDBOX_EXEC_TIMEOUT_MS=120000

# Public origin, when serving behind a reverse proxy (e.g. https://chat.example.com).
# ORIGIN=https://chat.example.com

# Group that owns the mounted Docker socket *inside* the app container.
# Docker Desktop presents it as root:root, so 0 is right there; on a Linux host
# use the numeric gid of the docker group (`stat -c %g /var/run/docker.sock`).
DOCKER_GID=0
